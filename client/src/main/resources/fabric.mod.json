{
  "schemaVersion": 1,
  "id": "crystal",
  "version": "${version}",
  "name": "Nexora Client",
  "description": "Nexora — A legit, feature-rich Minecraft client with a custom HUD and quality-of-life tools",
  "authors": ["Nexora Development Team"],
  "contact": {
    "homepage": "https://crystal-client.dev",
    "issues": "https://github.com/crystal-client/issues"
  },
  "license": "All Rights Reserved",
  "icon": "assets/crystal/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.crystal.client.CrystalClient"]
  },
  "mixins": ["crystal.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "recommends": {
    "sodium": "*",
    "lithium": "*",
    "krypton": "*"
  }
}
