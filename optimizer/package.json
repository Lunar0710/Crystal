{
  "name": "lunar-optimizer",
  "productName": "Lunar Optimizer",
  "version": "1.3.0",
  "description": "Windows fürs Gaming: Hardware-Check, Live-Monitor, Latenz und Optimierungen",
  "main": "main.js",
  "author": "Lunar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.33.13"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.lunar.optimizer",
    "productName": "Lunar Optimizer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Lunar-Optimizer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lunar Optimizer",
      "artifactName": "Lunar-Optimizer-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Lunar-Optimizer-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lunar0710.github.io/Crystal/optimizer/"
      }
    ]
  }
}
